  allowSms               Boolean                 @default(true)
  allowPhoneCalls        Boolean                 @default(true)
  allowPostalMail        Boolean                 @default(true)
  allowDirectoryListing  Boolean                 @default(true)
  allowPhotoUse          Boolean                 @default(true)
  emailOptOutDate        DateTime?
  smsOptOutDate          DateTime?
  directoryOptOutDate    DateTime?
  photoOptOutDate        DateTime?
  consentUpdatedAt       DateTime?
  consentUpdatedByUserId String?                 @db.Uuid
  mergedIntoMemberId     String?                 @db.Uuid
  mergedAt               DateTime?
  mergedByUserId         String?                 @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userAccount                 UserAccount?               @relation("MemberPortalAccount", fields: [userAccountId], references: [id], onDelete: SetNull)
  archivedBy                  UserAccount?               @relation("MemberArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  consentUpdatedBy            UserAccount?               @relation("MemberConsentUpdatedBy", fields: [consentUpdatedByUserId], references: [id], onDelete: SetNull)
  mergedIntoMember            Member?                    @relation("MemberMergedInto", fields: [mergedIntoMemberId], references: [id], onDelete: SetNull)
  mergedFromMembers           Member[]                   @relation("MemberMergedInto")
  mergedBy                    UserAccount?               @relation("MemberMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  householdLinks              MemberHousehold[]
  primaryContactForHouseholds MemberHouseholdUnit[]      @relation("MemberHouseholdPrimaryContact")
  emergencyContacts           MemberEmergencyContact[]
  attendances                 MemberAttendance[]
  followUps                   MemberFollowUp[]
  pastoralCareNotes           PastoralCareNote[]
  prayerRequests              PrayerRequest[]
  communications              MemberCommunication[]
  milestones                  MemberMilestone[]
  spiritualGifts              MemberSpiritualGift[]
  ministries                  MemberMinistry[]
  skills                      MemberSkill[]
  interests                   MemberInterest[]
  documents                   MemberDocument[]
  consentHistory              MemberConsentHistory[]
  mergesAsPrimary             MemberMerge[]              @relation("MergePrimaryMember")
  mergesAsDuplicate           MemberMerge[]              @relation("MergeDuplicateMember")
  duplicateCandidatesAsA      MemberDuplicateCandidate[] @relation("DuplicateMemberA")
  duplicateCandidatesAsB      MemberDuplicateCandidate[] @relation("DuplicateMemberB")
  eventOrganizerAssignments   EventOrganizer[]           @relation("EventOrganizerMember")
  eventRegistrations          EventRegistration[]        @relation("RegistrationMember")
  eventAttendeeRecords        EventAttendee[]            @relation("AttendeeMember")
  eventAttendanceRecords      EventAttendanceRecord[]    @relation("EventAttendanceMember")

  @@unique([organizationId, userAccountId])
  @@index([organizationId])
  @@index([organizationId, membershipStatus])
  @@index([organizationId, recordStatus])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, archivedAt])
  @@index([organizationId, deceasedDate])
  @@index([organizationId, createdAt])
  @@index([mergedIntoMemberId])
  @@index([userAccountId])
  @@map("members")
}

