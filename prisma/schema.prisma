  reason                   String
  requestedByUserAccountId String                      @db.Uuid
  reviewedByUserAccountId  String?                     @db.Uuid
  reviewNote               String?
  reviewedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

