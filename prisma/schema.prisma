  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  uploadedBy   UserAccount  @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, documentType])
  @@index([organizationId, isConfidential])
  @@index([memberId])
  @@index([expirationDate])
  @@map("member_documents")
}

// ---------------------------------------------------------------------------
// Events and calendar (Blueprint 7.1)
// ---------------------------------------------------------------------------

model EventCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  color          String?
  icon           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("event_categories")
}

model EventLocation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String
  description      String?
  address1         String?
  address2         String?
  city             String?
  state            String?
  zip              String?
  country          String?  @default("US")
  roomName         String?
  capacity         Int?
  isOnline         Boolean  @default(false)
  onlineMeetingUrl String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("event_locations")
}

model Event {
  id                       String          @id @default(uuid()) @db.Uuid
  organizationId           String          @db.Uuid
  title                    String
  slug                     String
  description              String?
  shortDescription         String?
  categoryId               String?         @db.Uuid
  locationId               String?         @db.Uuid
  eventStatus              EventStatus     @default(DRAFT)
  visibility               EventVisibility @default(STAFF_ONLY)
  startDateTime            DateTime
  endDateTime              DateTime
  timezone                 String          @default("America/Chicago")
  isAllDay                 Boolean         @default(false)
  registrationRequired     Boolean         @default(false)
  registrationOpenDate     DateTime?
  registrationCloseDate    DateTime?
  registrationCapacity     Int?
  waitlistEnabled          Boolean         @default(false)
  registrationFee          Decimal?        @db.Decimal(10, 2)
  registrationInstructions String?
  contactName              String?
  contactEmail             String?
  contactPhone             String?
  featuredImageUrl         String?
  featuredImageKey         String?
  isRecurring              Boolean         @default(false)
  recurrenceRule           String?
  recurrenceEndDate        DateTime?
  parentEventId            String?         @db.Uuid
  createdByUserId          String          @db.Uuid
  updatedByUserId          String?         @db.Uuid
  publishedAt              DateTime?
  cancelledAt              DateTime?
  archivedAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             EventCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location             EventLocation?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parentEvent          Event?                     @relation("EventOccurrences", fields: [parentEventId], references: [id], onDelete: Restrict)
  occurrences          Event[]                    @relation("EventOccurrences")
  createdBy            UserAccount                @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            UserAccount?               @relation("EventUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  organizers           EventOrganizer[]
  ministries           EventMinistry[]
  attendances          MemberAttendance[]
  registrationSettings EventRegistrationSettings?
  registrations        EventRegistration[]
  attendees            EventAttendee[]
  waitlistEntries      EventWaitlistEntry[]
  promotionOffers      EventPromotionOffer[]
  checkInSettings      EventCheckInSettings?
  checkInStations      EventCheckInStation[]
  attendanceRecords    EventAttendanceRecord[]
  attendanceActions    EventAttendanceAction[]
  qrPasses             EventQrPass[]
  checkInIdempotency   EventCheckInIdempotency[]

  @@unique([organizationId, slug])
  /// Enables tenant-aware composite FKs (e.g. EventQrPass).
  @@unique([organizationId, id])
  @@index([organizationId, eventStatus])
  @@index([organizationId, visibility])
  @@index([organizationId, startDateTime])
  @@index([organizationId, endDateTime])
  @@index([categoryId])
  @@index([locationId])
  @@index([parentEventId])
  @@map("events")
}

model EventRegistrationSettings {
  id                          String                      @id @default(uuid()) @db.Uuid
  organizationId              String                      @db.Uuid
  eventId                     String                      @unique @db.Uuid
  isEnabled                   Boolean                     @default(false)
  visibility                  EventRegistrationVisibility @default(PUBLIC)
  opensAt                     DateTime?
  closesAt                    DateTime?
  capacity                    Int?
  waitlistEnabled             Boolean                     @default(false)
  waitlistCapacity            Int?
  promotionMode               EventWaitlistPromotionMode  @default(AUTOMATIC)
  maxAttendeesPerRegistration Int                         @default(1)
  allowHouseholdRegistration  Boolean                     @default(true)
  allowGuestRegistration      Boolean                     @default(true)
  requireAuthentication       Boolean                     @default(false)
  requireEmail                Boolean                     @default(true)
  requirePhone                Boolean                     @default(false)
  requireDateOfBirth          Boolean                     @default(false)
  requireEmergencyContact     Boolean                     @default(false)
  requireGuardianForMinors    Boolean                     @default(false)
  allowCancellation           Boolean                     @default(true)
  cancellationDeadline        DateTime?
  confirmationMessage         String?
  instructions                String?
  checkInEnabled              Boolean                     @default(true)
  qrCheckInEnabled            Boolean                     @default(false)
  showCapacityPublicly        Boolean                     @default(true)
  showWaitlistPublicly        Boolean                     @default(false)
  confirmationRequired        Boolean                     @default(false)
  promotionOfferTtlMinutes    Int                         @default(1440)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, isEnabled])
  @@map("event_registration_settings")
}

model EventRegistration {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  eventId             String                  @db.Uuid
  status              EventRegistrationStatus @default(PENDING)
  source              EventRegistrationSource @default(PUBLIC_GUEST)
  confirmationCode    String
  memberId            String?                 @db.Uuid
  householdId         String?                 @db.Uuid
  registeredByUserId  String?                 @db.Uuid
  cancelledByUserId   String?                 @db.Uuid
  primaryContactName  String
  primaryContactEmail String?
  primaryContactPhone String?
  notes               String?
  partySize           Int                     @default(1)
  waitlistPosition    Int?
  offeredAt           DateTime?
  offerExpiresAt      DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  confirmedAt         DateTime?
  checkedInAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member       Member?                   @relation("RegistrationMember", fields: [memberId], references: [id], onDelete: SetNull)
  household    MemberHouseholdUnit?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  registeredBy UserAccount?              @relation("RegistrationRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  cancelledBy  UserAccount?              @relation("RegistrationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  attendees    EventAttendee[]
  waitlistEntry EventWaitlistEntry?
  promotionOffers EventPromotionOffer[]
  attendanceRecords EventAttendanceRecord[]
  qrPasses     EventQrPass[]

  @@unique([organizationId, confirmationCode])
  /// Enables tenant+event composite FKs (e.g. EventQrPass).
  @@unique([organizationId, eventId, id])
  @@index([organizationId, eventId, status])
  @@index([organizationId, eventId, createdAt])
  @@index([organizationId, eventId, primaryContactEmail])
  @@index([eventId, waitlistPosition])
  @@index([memberId])
  @@map("event_registrations")
}

model EventAttendee {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @db.Uuid
  registrationId        String            @db.Uuid
  eventId               String            @db.Uuid
  status                EventAttendeeStatus @default(REGISTERED)
  attendeeType          EventAttendeeType @default(GUEST)
  memberId              String?           @db.Uuid
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?         @db.Date
  isGuest               Boolean           @default(false)
  isMinor               Boolean           @default(false)
  guardianName          String?
  guardianPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  accommodationRequest  String?
  dietaryNotes          String?
  internalNotes         String?
  waitlistPosition      Int?
  checkedInAt           DateTime?
  checkedInByUserId     String?           @db.Uuid
  checkInToken          String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member       Member?           @relation("AttendeeMember", fields: [memberId], references: [id], onDelete: SetNull)
  checkedInBy  UserAccount?      @relation("AttendeeCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  attendanceRecords EventAttendanceRecord[]
  qrPasses     EventQrPass[]

  @@unique([eventId, checkInToken])
  /// Enables tenant+event+registration composite FKs (e.g. EventQrPass).
  @@unique([organizationId, eventId, registrationId, id])
  @@index([organizationId, eventId, status])
  @@index([organizationId, eventId, memberId])
  @@index([organizationId, eventId, lastName, firstName])
  @@index([registrationId])
  @@index([memberId])
  @@map("event_attendees")
}

model EventWaitlistEntry {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  eventId        String                   @db.Uuid
  registrationId String                   @unique @db.Uuid
  position       Int
  partySize      Int
  status         EventWaitlistEntryStatus @default(WAITING)
  joinedAt       DateTime                 @default(now())
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  expiredAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([eventId, position])
  @@index([organizationId, eventId, status, position])
  @@index([eventId, offerExpiresAt])
  @@map("event_waitlist_entries")
}

model EventPromotionOffer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  eventId        String    @db.Uuid
  registrationId String    @db.Uuid
  tokenHash      String
  purpose        String    @default("WAITLIST_PROMOTION")
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, tokenHash])
  @@index([registrationId])
  @@index([expiresAt])
  @@map("event_promotion_offers")
}

model EventCheckInSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  eventId              String    @unique @db.Uuid
  checkInEnabled       Boolean   @default(false)
  checkInOpensAt       DateTime?
  checkInClosesAt      DateTime?
  allowSelfCheckIn     Boolean   @default(false)
  allowWalkIns         Boolean   @default(false)
  allowCheckOut        Boolean   @default(false)
  allowReentry         Boolean   @default(false)
  requireRegistration  Boolean   @default(true)
  qrPassEnabled        Boolean   @default(true)
  stationNameRequired  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkInEnabled])
  @@map("event_check_in_settings")
}

model EventCheckInStation {
  id              String                    @id @default(uuid()) @db.Uuid
  organizationId  String                    @db.Uuid
  eventId         String                    @db.Uuid
  name            String                    @db.VarChar(80)
  /// lower(trim(name)) — used for case-normalized uniqueness among ACTIVE stations
  nameNormalized  String                    @db.VarChar(80)
  status          EventCheckInStationStatus @default(ACTIVE)
  deviceLabel     String?                   @db.VarChar(80)
  openedByUserId  String                    @db.Uuid
  openedAt        DateTime                  @default(now())
  closedByUserId  String?                   @db.Uuid
  closedAt        DateTime?
  lastActivityAt  DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  openedBy     UserAccount            @relation("CheckInStationOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy     UserAccount?           @relation("CheckInStationClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  attendanceRecords EventAttendanceRecord[]
  attendanceActions EventAttendanceAction[]

  /// Enables tenant+event composite FKs from attendance rows/actions.
  @@unique([organizationId, eventId, id])
  @@index([organizationId, eventId, status])
  @@index([organizationId, eventId, nameNormalized])
  @@index([organizationId, openedByUserId])
  @@map("event_check_in_stations")
}

model EventAttendanceRecord {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  eventId            String                 @db.Uuid
  registrationId     String?                @db.Uuid
  attendeeId         String?                @db.Uuid
  memberId           String?                @db.Uuid
  status             EventAttendanceStatus  @default(EXPECTED)
  /// Null until a check-in (or correction) action sets a source.
  source             EventAttendanceSource?
  firstCheckedInAt   DateTime?
  lastCheckedInAt    DateTime?
  checkedOutAt       DateTime?
  checkInCount       Int                    @default(0)
  /// Station of the most recent effective check-in (null when none / unattributed).
  stationId          String?                @db.Uuid
  checkedInByUserId  String?                @db.Uuid
  checkedOutByUserId String?                @db.Uuid
  walkInFirstName    String?
  walkInLastName     String?
  walkInEmail        String?
  walkInPhone        String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration EventRegistration?     @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  attendee     EventAttendee?         @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  member       Member?                @relation("EventAttendanceMember", fields: [memberId], references: [id], onDelete: SetNull)
  station      EventCheckInStation?   @relation(fields: [organizationId, eventId, stationId], references: [organizationId, eventId, id], onDelete: Restrict)
  checkedInBy  UserAccount?           @relation("EventAttendanceCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  checkedOutBy UserAccount?           @relation("EventAttendanceCheckedOutBy", fields: [checkedOutByUserId], references: [id], onDelete: SetNull)
  actions      EventAttendanceAction[]

  @@unique([organizationId, eventId, attendeeId])
  @@index([organizationId, eventId, status])
  @@index([organizationId, eventId, memberId])
  @@index([organizationId, eventId, registrationId])
  @@index([organizationId, eventId, stationId])
  @@index([organizationId, eventId, lastCheckedInAt])
  @@index([organizationId, eventId, walkInLastName, walkInFirstName])
  @@map("event_attendance_records")
}

model EventAttendanceAction {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  eventId        String                    @db.Uuid
  attendanceId   String                    @db.Uuid
  action         EventAttendanceActionType
  source         EventAttendanceSource
  /// Station where this action occurred (null when unattributed).
  stationId      String?                   @db.Uuid
  actorUserId    String?                   @db.Uuid
  occurredAt     DateTime                  @default(now())
  reason         String?
  metadata       Json?
  createdAt      DateTime                  @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendance   EventAttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  station      EventCheckInStation? @relation(fields: [organizationId, eventId, stationId], references: [organizationId, eventId, id], onDelete: Restrict)
  actor        UserAccount?         @relation("EventAttendanceActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventId, occurredAt])
  @@index([organizationId, eventId, stationId, occurredAt])
  @@index([attendanceId, occurredAt])
  @@map("event_attendance_actions")
}

model EventQrPass {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  eventId           String             @db.Uuid
  registrationId    String             @db.Uuid
  /// Null for party-level passes bound only to the registration.
  attendeeId        String?            @db.Uuid
  /// SHA-256 hex of the opaque bearer token — never store the raw token.
  tokenHash         String
  /// SHA-256 hex of the human-entry fallback code — never store plaintext.
  fallbackCodeHash  String
  purpose           EventQrPassPurpose @default(EVENT_CHECK_IN)
  status            EventQrPassStatus  @default(ACTIVE)
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedByUserId   String?            @db.Uuid
  rotatedAt         DateTime?
  /// Points at the successor pass when this row was rotated/replaced.
  replacedByTokenId String?            @db.Uuid
  lastUsedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  registration EventRegistration @relation(fields: [organizationId, eventId, registrationId], references: [organizationId, eventId, id], onDelete: Cascade)
  attendee     EventAttendee?    @relation(fields: [organizationId, eventId, registrationId, attendeeId], references: [organizationId, eventId, registrationId, id], onDelete: SetNull)
  revokedBy    UserAccount?      @relation("EventQrPassRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  replacedBy   EventQrPass?      @relation("EventQrPassReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces     EventQrPass[]     @relation("EventQrPassReplacement")

  @@unique([tokenHash])
  @@unique([fallbackCodeHash])
  @@index([organizationId, purpose, tokenHash])
  @@index([organizationId, eventId, registrationId])
  @@index([organizationId, eventId, attendeeId])
  @@index([organizationId, eventId, status, expiresAt])
  @@index([replacedByTokenId])
  @@index([registrationId, status, createdAt])
  @@map("event_qr_passes")
}

model EventCheckInIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  eventId        String   @db.Uuid
  operationKey   String
  attendanceId   String?
  resultSummary  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventId, operationKey])
  @@index([eventId, createdAt])
  @@map("event_check_in_idempotency")
}

model EventOrganizer {
  id             String             @id @default(uuid()) @db.Uuid
  eventId        String             @db.Uuid
  userId         String?            @db.Uuid
  memberId       String?            @db.Uuid
  organizerName  String?
  organizerEmail String?
  organizerPhone String?
  role           EventOrganizerRole @default(OTHER)
  isPrimary      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   UserAccount? @relation("EventOrganizerUser", fields: [userId], references: [id], onDelete: SetNull)
  member Member?      @relation("EventOrganizerMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([memberId])
  @@map("event_organizers")
}

model EventMinistry {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  ministryId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Restrict)

  @@unique([eventId, ministryId])
  @@index([ministryId])
  @@map("event_ministries")
}
