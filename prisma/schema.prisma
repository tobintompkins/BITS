  reviewedBy   UserAccount?          @relation("StatementVoidReviewedBy", fields: [reviewedByUserAccountId], references: [id], onDelete: Restrict)

  // Partial unique index in SQL: one PENDING request per statement.
  @@index([organizationId, status, createdAt])
  @@index([contributionStatementId, createdAt])
  @@index([requestedByUserAccountId])
  @@index([reviewedByUserAccountId])
  @@map("statement_void_requests")
