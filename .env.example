# PostgreSQL connection string for Prisma and the BITS application.
# Copy this file to `.env` and replace the placeholder values before running migrations.
#
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bits?schema=public"
#
# Railway example (set in the Railway service variables, not committed):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Direct (non-pooled) database URL for migrations / Prisma when using a pooler.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk sign-in and sign-up page URLs (must match app routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# After sign-in/sign-up, Clerk redirects here by default unless overridden per flow
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Pin clerk-js to a versioned script. The unversioned @6 URL 307s and browsers
# fail to load it, which blocks the sign-in UI.
NEXT_PUBLIC_CLERK_JS_VERSION=6.36.0

# Application base URL for local development
APP_BASE_URL=http://localhost:3000

# Stripe sandbox (test mode only). Never use live keys in this increment.
# STRIPE_SECRET_KEY must start with sk_test_. Do not commit a real key.
# STRIPE_SECRET_KEY=sk_test_

# Webhook signing secret. Must start with whsec_. Leave empty until configured.
# Local Stripe CLI (`stripe listen`) uses a different secret than a Dashboard
# endpoint. Rotate by creating a new endpoint/secret and updating this value.
STRIPE_WEBHOOK_SECRET=

# Optional: root directory for private member / event document storage
# (defaults to process.cwd(); files land under storage/private/...)
# BITS_FILE_STORAGE_ROOT=

# Private contribution-statement PDFs. New writes use local files in
# development. Production requires an S3-compatible private bucket.
# Do not put secrets in NEXT_PUBLIC_* variables. Existing local keys
# (`private/statements/...`) keep working; new remote keys use `s3v1:`.
# BITS_STATEMENT_PDF_BACKEND=local
# BITS_STATEMENT_ALLOW_LOCAL_PRODUCTION=1
# BITS_STATEMENT_S3_BUCKET=
# BITS_STATEMENT_S3_REGION=
# BITS_STATEMENT_S3_ENDPOINT=
# BITS_STATEMENT_S3_FORCE_PATH_STYLE=1
# BITS_STATEMENT_S3_PREFIX=
# BITS_STATEMENT_S3_ALLOW_INSECURE_HTTP=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: Leadership Portal shared-computer idle timeout (whole minutes, 5–120).
# Default 20. Invalid values fall back to 20. Staff routes only.
# BITS_STAFF_IDLE_TIMEOUT_MINUTES=20
# Warning appears this many whole minutes before sign-out (must be less than timeout).
# Default 2. Invalid values fall back to 2.
# BITS_STAFF_IDLE_WARNING_MINUTES=2

# Optional: auto-provision org access for first signed-in staff user (dev only)
# BITS_AUTO_PROVISION_ORG_ACCESS=false

# Recommended in production: HMAC secret for event check-in QR tokens
# BITS_CHECKIN_HMAC_SECRET=

# Future rate-limit integration (Redis / Upstash) — unused until enabled
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_UPSTASH_REDIS_REST_URL=
# RATE_LIMIT_UPSTASH_REDIS_REST_TOKEN=

# Optional Playwright e2e (Clerk test user) — do not commit real credentials
# E2E_CLERK_USER_EMAIL=
# E2E_CLERK_USER_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000
